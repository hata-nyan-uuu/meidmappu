<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="戻る"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="店舗追加"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="店名" />

        <EditText
            android:id="@+id/editAddress"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="住所"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/editTime"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="営業時間"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/editNumber"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="電話番号"
            android:inputType="phone"
            android:maxLines="1"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/edit_website"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="公式サイトのURL"
            android:inputType="textUri"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/edit_instagram"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="instagramのリンク"
            android:inputType="textUri"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/edit_x"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="X(旧ツイッター)のリンク"
            android:inputType="textUri"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/edit_tiktok"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="TikTokのリンク"
            android:inputType="textUri"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/editImage"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="メイン画像URL"
            android:inputType="textUri"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/editMenu"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="メニュー画像URL"
            android:inputType="textUri"
            android:layout_marginTop="12dp"/>

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/feeling"
            android:text="ごはんたべたい"/>
        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/feeling1"
            android:text="ゆっくりしたい"/>
        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/feeling2"
            android:text="だれかとはなしたい"/>
        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/feeling3"
            android:text="お酒をのみたい"/>


        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:entries="@array/mise_type"/>

        <Spinner
            android:id="@+id/spinnerPrice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:entries="@array/kakaku"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/spinnerConcept"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:entries="@array/conseputo2"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnSaveShop"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="保存"
            android:textSize="30sp"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
