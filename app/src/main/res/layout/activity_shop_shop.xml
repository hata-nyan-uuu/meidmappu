<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/midemaphaikei">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

            <!-- 戻るボタン -->
            <ImageButton
                android:id="@+id/backbtn"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/modoru2"
                android:contentDescription="戻るボタン" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/randombtn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="ランダム検索ボタン" />
    </LinearLayout>





        <!-- 店名 -->
        <TextView
            android:id="@+id/shop_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="店名"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <!-- 店舗画像 -->
        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/komorebiout"
            android:layout_marginTop="16dp" />

        <!-- メニュータイトル -->
        <TextView
            android:id="@+id/menuname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="menu"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- メニュー画像 -->
        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/komorebi"
            android:layout_marginTop="12dp" />

        <!-- 住所 -->
        <TextView
            android:id="@+id/addressname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="住所"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/shop_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="〇〇県〇〇市"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/address_tap_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="（タップでマップを開く）"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="#666666"
            android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/sharp1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            />
        <TextView
            android:id="@+id/janru_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="メイドカフェ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        </LinearLayout>

<!--コンセプトゾーン-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/sharp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            />

        <TextView
            android:id="@+id/concept_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="メイド系"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/fellintitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginTop="4dp"/>
        <TextView
            android:id="@+id/feeling_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ゆっくりしたい"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

        <!-- 営業時間 一列表示 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="営業時間"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"/>

            <TextView
                android:id="@+id/time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00~22:00"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginTop="14dp" />

        </LinearLayout>

        <!-- レビュー -->
        <TextView
            android:id="@+id/review_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="レビュー"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/review_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:layout_marginTop="8dp" />

        <!-- レビュー投稿ボタン -->
        <Button
            android:id="@+id/review_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="レビューを書く"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />


    </LinearLayout>
</ScrollView>
